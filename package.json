{
  "name": "dsh-atan-daily",
  "version": "1.2.1",
  "description": "DeepSeek Harness plugin: scheduled collection tasks that each file a timestamped report.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scheduled-tasks",
    "reports"
  ],
  "author": "Artanis Zhou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artaniszhou/dsh-atan-daily.git"
  },
  "homepage": "https://github.com/artaniszhou/dsh-atan-daily#readme",
  "bugs": {
    "url": "https://github.com/artaniszhou/dsh-atan-daily/issues"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "skill/**/*.md",
    "schema/**/*.json",
    "assets/**/*",
    "templates/**/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "build": "npm run typecheck && npm run clean && npm run build:host && npm run build:client",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown",
    "watch": "tsdown --watch",
    "check": "npm run check:version && npm run build",
    "prepack": "npm run check:version && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "echarts": "^6.1.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4"
  }
}
